# SWASEMI Cold-Chain Monitoring Platform - Environment Variables Template
# DO NOT include real production credentials in this file.

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./swasemi_coldchain.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swasemi_coldchain
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=swasemi_coldchain

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# Security / Authentication
JWT_SECRET=supersecretkey_change_in_production_36hr_assessment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MQTT Broker Configuration
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=swasemi/coldchain/trackers
MQTT_USERNAME=
MQTT_PASSWORD=

# SMTP Email Configuration (For Real Temperature Breach Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@swasemi.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=alerts@swasemi.com

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
